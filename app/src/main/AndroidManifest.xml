<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:theme="@style/Theme.RuVideoHub"
        android:label="RuVideoHub"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <!--
          usesCleartextTraffic оставлен включённым намеренно: часть пользовательских
          JSON/API источников, которые вы сами прописываете в настройках, могут быть
          доступны только по HTTP. Если все ваши источники работают по HTTPS —
          можно смело выставить это значение в false.
        -->

        <activity
            android:name=".MainActivity"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SourceBrowserActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".player.PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.RuVideoHub.Player"
            android:exported="false" />
    </application>
</manifest>
